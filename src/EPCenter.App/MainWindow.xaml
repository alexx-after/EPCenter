<Window x:Class="EPCenter.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="EPCenter" Height="760" Width="1320" MinHeight="500" MinWidth="900" WindowStartupLocation="CenterScreen">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,12">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <Button x:Name="ScanFileContainersButton" Content="Файловые контейнеры" Click="ScanFileContainersButton_Click" Margin="0,0,8,0"/>
    <Button x:Name="ScanReadersButton" Content="Сканировать считыватели" Click="ScanReadersButton_Click" Margin="0,0,8,0"/>
    <Button x:Name="ScanContainersButton" Content="Контейнеры CryptoPro" Click="ScanContainersButton_Click"/>
    <Button x:Name="ScanButton" Content="Сканировать сертификаты" Click="ScanButton_Click"/>
   </StackPanel>
   <StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="EPCenter" FontSize="26" FontWeight="SemiBold"/>
     <TextBlock x:Name="AppVersionText" Text="v0.7.0" Margin="10,8,0,0" Foreground="Gray" FontSize="13" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock Text="Инвентаризация сертификатов электронной подписи" Foreground="Gray"/>
    <TextBlock x:Name="CryptoProVersionText" Text="CryptoPro CSP: проверка…" Margin="0,5,0,0" FontWeight="SemiBold"/>
   </StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="#FFF3F5F8" CornerRadius="6" Padding="10" Margin="0,0,0,10">
   <TextBlock Text="Режим чтения. Перечисление контейнеров не выполняет подпись, экспорт или изменение ключей. PIN не запрашивается приложением." TextWrapping="Wrap"/>
  </Border>
  <TabControl Grid.Row="2">
   <TabItem Header="Сертификаты Windows">
    <DataGrid x:Name="CertificatesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Субъект" Binding="{Binding Subject}" Width="2*"/>
      <DataGridTextColumn Header="Издатель" Binding="{Binding Issuer}" Width="2*"/>
      <DataGridTextColumn Header="Отпечаток" Binding="{Binding Thumbprint}" Width="1.5*"/>
      <DataGridTextColumn Header="Действителен с" Binding="{Binding NotBefore, StringFormat={}{0:dd.MM.yyyy}}" Width="105"/>
      <DataGridTextColumn Header="Действителен до" Binding="{Binding NotAfter, StringFormat={}{0:dd.MM.yyyy}}" Width="105"/>
      <DataGridTextColumn Header="Хранилище" Binding="{Binding StoreLocation}" Width="95"/>
      <DataGridCheckBoxColumn Header="Есть ключ" Binding="{Binding HasPrivateKey}" Width="80"/>
      <DataGridTextColumn Header="Доступность закрытого ключа" Binding="{Binding PrivateKeyStatus}" Width="2*"/>
      <DataGridTextColumn Header="Провайдер" Binding="{Binding ProviderName}" Width="1.5*"/>
      <DataGridTextColumn Header="Контейнер" Binding="{Binding ContainerName}" Width="2*"/>
      <DataGridTextColumn Header="Сопоставление" Binding="{Binding ContainerMatchStatus}" Width="2*"/>
      <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="110"/>
     </DataGrid.Columns>
    </DataGrid>
   </TabItem>
   <TabItem Header="Контейнеры CryptoPro">
    <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock x:Name="ContainerStatusText" Grid.Row="0" Margin="0,0,0,8" Foreground="Gray" Text="Нажмите «Контейнеры CryptoPro» для перечисления контейнеров."/>
     <DataGrid x:Name="ContainersGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Полное имя контейнера" Binding="{Binding FullName}" Width="3*"/>
       <DataGridTextColumn Header="Область" Binding="{Binding Scope}" Width="160"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </TabItem>
   <TabItem Header="Считыватели">
    <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock x:Name="ReadersStatusText" Grid.Row="0" Margin="0,0,0,8" Foreground="Gray" Text="Сканирование PC/SC считывателей и чтение ATR вставленной карты без PIN."/>
     <DataGrid x:Name="ReadersGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Имя считывателя Windows" Binding="{Binding ReaderName}" Width="3*"/>
       <DataGridTextColumn Header="Предполагаемый производитель" Binding="{Binding VendorHint}" Width="2*"/>
       <DataGridTextColumn Header="Метод обнаружения" Binding="{Binding DetectionMethod}" Width="140"/>
       <DataGridTextColumn Header="Состояние карты" Binding="{Binding CardStatus}" Width="2*"/>
       <DataGridTextColumn Header="ATR" Binding="{Binding Atr}" Width="2*"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </TabItem>
   <TabItem Header="Файловые контейнеры">
    <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock x:Name="FileContainersStatusText" Grid.Row="0" Margin="0,0,0,8" Foreground="Gray" Text="Поиск папок CryptoPro на съёмных дисках. Содержимое файлов не читается."/>
     <DataGrid x:Name="FileContainersGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Съёмный диск" Binding="{Binding DriveName}" Width="150"/>
       <DataGridTextColumn Header="Путь к контейнеру" Binding="{Binding ContainerPath}" Width="3*"/>
       <DataGridTextColumn Header="Файлов найдено" Binding="{Binding KeyFilesFound}" Width="120"/>
       <DataGridTextColumn Header="Результат проверки" Binding="{Binding DetectionStatus}" Width="2*"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </TabItem>
  </TabControl>
  <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,10,0,0" Foreground="Gray" Text="Готово."/>
 </Grid>
</Window>
