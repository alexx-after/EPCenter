<Window x:Class="EPCenter.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="EPCenter — сертификаты электронной подписи" Height="720" Width="1180" MinHeight="480" MinWidth="820" WindowStartupLocation="CenterScreen">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,12"><Button x:Name="ScanButton" Content="Сканировать" DockPanel.Dock="Right" VerticalAlignment="Center" Click="ScanButton_Click"/>
   <StackPanel><TextBlock Text="EPCenter" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Инвентаризация сертификатов Windows" Foreground="Gray"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="#FFF3F5F8" CornerRadius="6" Padding="10" Margin="0,0,0,10">
   <TextBlock Text="Режим только чтение. Экспорт ключей и запрос PIN в этой версии не выполняются." TextWrapping="Wrap"/>
  </Border>
  <DataGrid x:Name="CertificatesGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Субъект" Binding="{Binding Subject}" Width="2*"/>
    <DataGridTextColumn Header="Издатель" Binding="{Binding Issuer}" Width="2*"/>
    <DataGridTextColumn Header="Отпечаток" Binding="{Binding Thumbprint}" Width="1.5*"/>
    <DataGridTextColumn Header="Действителен с" Binding="{Binding NotBefore, StringFormat={}{0:dd.MM.yyyy}}" Width="115"/>
    <DataGridTextColumn Header="Действителен до" Binding="{Binding NotAfter, StringFormat={}{0:dd.MM.yyyy}}" Width="115"/>
    <DataGridTextColumn Header="Хранилище" Binding="{Binding StoreLocation}" Width="105"/>
    <DataGridCheckBoxColumn Header="Закрытый ключ" Binding="{Binding HasPrivateKey}" Width="105"/>
    <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="125"/>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,10,0,0" Foreground="Gray" Text="Нажмите «Сканировать» для начала."/>
 </Grid>
</Window>
